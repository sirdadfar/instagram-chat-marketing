APP_NAME="IG Automate"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Tehran

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=instagram_automation
DB_USERNAME=instagram_automation
DB_PASSWORD=change-me

QUEUE_CONNECTION=database
CACHE_STORE=file
SESSION_DRIVER=file

# Generate with: php artisan panel:password-hash
PANEL_ADMIN_PASSWORD_HASH=
PANEL_ADMIN_LABEL=مدیر پنل

# Optional: configured values below can be overridden from the panel UI
# (Settings page) — UI values are stored encrypted in the database
# and take priority over these env vars.
# Per-user keys can also be set by each user from the Settings screen.
ZERNIO_BASE_URL=https://zernio.com/api/v1
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
ZERNIO_ACCOUNT_ID=

# Initial admin bootstrap (used by `php artisan panel:adopt-legacy`)
PANEL_ADMIN_EMAIL=
PANEL_ADMIN_USERNAME=
# Panel password is no longer used for login; users log in with username+password.
# PANEL_ADMIN_PASSWORD is only consumed when bootstrapping the admin user.
PANEL_ADMIN_PASSWORD=
INSTAGRAM_USERNAME=
