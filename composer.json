{
    "name": "igautomate/instagram-automation-panel",
    "type": "project",
    "description": "Multi-tenant Instagram automation panel built on Laravel 12 and the Zernio API: comment, story and DM automations with follow-gates, keyword matching, rate limiting, an inbox and a Persian RTL management UI.",
    "keywords": [
        "laravel",
        "instagram",
        "automation",
        "chat-marketing",
        "chatbot",
        "zernio",
        "multi-tenant",
        "rtl"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.21",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "@php artisan test"
        ],
        "pint": [
            "pint --dirty"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
